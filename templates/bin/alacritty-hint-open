#!/usr/bin/env bash
set -euo pipefail

# Open the text an Alacritty hint matched.
#
# Alacritty appends the matched text as the last argument, so the generated
# hint rules under ~/.config/alacritty -- hints-github.toml, hints-linear.toml
# and hints-dex.toml -- just point their `command` here:
#
#   alacritty-hint-open getsentry/sentry-toolbar#272
#     -> https://github.com/getsentry/sentry-toolbar/issues/272
#        (GitHub redirects /issues/N to /pull/N when N is a pull request)
#   alacritty-hint-open --workspace getsentry REPLAY-431
#     -> task://linear/REPLAY-431, or the Linear website with no --url-template
#   alacritty-hint-open --dex-store ~/.dex 'r3jiacqe'
#     -> ~/.dex/tasks/r3jiacqe.json, or --url-template with {id} filled in
#
# Those rules are generated, see ~/.dotFiles/generators/.config/alacritty/.

workspace=""
dex_store="$HOME/.dex"
url_template=""
print_only=""

while [ $# -gt 1 ]; do
  case "$1" in
    --workspace) workspace="$2"; shift 2 ;;
    --dex-store) dex_store="$2"; shift 2 ;;
    --url-template) url_template="$2"; shift 2 ;;
    --print) print_only=1; shift ;;
    --) shift; break ;;
    *) shift ;;
  esac
done

raw="${1:-}"
if [ -z "$raw" ]; then
  echo "usage: $(basename "$0") [--workspace SLUG] [--dex-store DIR] [--url-template URL] [--print] TEXT" >&2
  exit 64
fi

# dex 0.16 keeps every task on one line of tasks.jsonl; older versions kept a
# file per task under tasks/.
dex_task_exists() {
  [ -f "$dex_store/tasks/$1.json" ] && return 0
  [ -f "$dex_store/tasks.jsonl" ] || return 1
  grep -q "\"id\"[[:space:]]*:[[:space:]]*\"$1\"" "$dex_store/tasks.jsonl"
}

# A dex id turns up bare, or decorated the way dex list and dex show print it.
dex_id=""
if [[ "$raw" =~ ^\[[[:space:]x]\][[:space:]]([a-z0-9]{8}):$ ]] || [[ "$raw" =~ ^([a-z0-9]{8})$ ]]; then
  dex_id="${BASH_REMATCH[1]}"
fi

# Hints grab whatever the regex matched; drop wrapping punctuation.
text="${raw#[\(\[\<\"\']}"
text="${text%[\)\]\>\"\',.:;]}"

if [ -z "$workspace" ]; then
  # `default = "getsentry"`, as written by the linear CLI.
  workspace="$(sed -n 's/^default[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$HOME/.config/linear/credentials.toml" 2>/dev/null | head -1)"
fi

if [[ "$text" =~ ^([A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9._-]+)#([0-9]+)$ ]]; then
  target="https://github.com/${BASH_REMATCH[1]}/issues/${BASH_REMATCH[2]}"
elif [[ "$text" =~ ^([A-Za-z][A-Za-z0-9]{1,9})-([0-9]+)$ ]]; then
  if [ -z "$workspace" ]; then
    echo "$(basename "$0"): no Linear workspace; pass --workspace or run \`linear auth login\`" >&2
    exit 1
  fi
  key="$(echo "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')"
  id="${key}-${BASH_REMATCH[2]}"
  if [ -n "$url_template" ]; then
    target="${url_template//\{id\}/$id}"
  else
    target="https://linear.app/${workspace}/issue/${id}"
  fi
elif [ -n "$dex_id" ] && dex_task_exists "$dex_id"; then
  if [ -n "$url_template" ]; then
    target="${url_template//\{id\}/$dex_id}"
  else
    target="$dex_store/tasks/$dex_id.json"
    [ -f "$target" ] || target="$dex_store/tasks.jsonl"
  fi
elif [ -n "$dex_id" ]; then
  echo "$(basename "$0"): no dex task $dex_id in $dex_store" >&2
  exit 1
else
  echo "$(basename "$0"): don't know how to open '$raw'" >&2
  exit 1
fi

if [ -n "$print_only" ]; then
  echo "$target"
elif command -v open >/dev/null; then
  exec open "$target"
else
  exec xdg-open "$target"
fi
