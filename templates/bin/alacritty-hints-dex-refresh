#!/usr/bin/env bash
set -euo pipefail

# Rewrite ~/.config/alacritty/hints-dex.toml from the dex task store, so that
# task ids created since the last run become clickable. Alacritty reloads the
# file on its own once it changes.
#
# Run by hand after adding tasks, or left to
# ~/Library/LaunchAgents/com.ryan953.alacritty-hints-dex.plist, which watches
# the task store and calls this.

# LaunchAgents run with a minimal PATH; the generator wants the usual tools.
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin"

generator="$HOME/.dotFiles/generators/.config/alacritty/hints-dex.toml"
out="$HOME/.config/alacritty/hints-dex.toml"

# logs/ must exist before launchd opens StandardOut/ErrorPath.
mkdir -p "$HOME/.local/alacritty-hints/logs"

[ -x "$generator" ] || { echo "$(basename "$0"): no generator at $generator" >&2; exit 1; }

# Write beside the target first, so a failed run leaves the old file in place.
tmp="$(mktemp "${TMPDIR:-/tmp}/hints-dex.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
"$generator" > "$tmp"
mv "$tmp" "$out"
trap - EXIT

echo "### $(date '+%Y-%m-%d %H:%M:%S') wrote $out"
